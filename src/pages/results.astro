---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineChart from '../components/LineChart.astro';
import Figure from '../components/Figure.astro';
import ResultsTable from '../components/ResultsTable.astro';
import { url } from '../utils/url';

const csvUrl = url('/assets/data/mask_metrics_sam2_vs_yolo.csv');

const mainColumns = [
  'Method',
  'Videos',
  'Frames/video',
  'Full PSNR &uarr;',
  'Full SSIM &uarr;',
  'BG PSNR &uarr;',
  'BG MAE &darr;',
  'Edit PSNR &uarr;',
  'Edit SSIM &uarr;',
  'Edit MAE &darr;',
  'LPIPS &darr;',
];

const mainRows = [
  ['GAN baseline', 18, 200, '23.56', '0.645', '26.28', '9.42', '16.84', '0.472', '27.86', '0.4949'],
  ['CLIP-guided variant', 18, 120, '84.59', '0.99998', '82.49', '0.00032', '82.26', '0.99997', '0.00076', '0.000006'],
  ['Stable Diffusion + SAM2', 7, 60, '20.61', '0.698', '28.11', '8.41', '9.85', '0.268', '62.50', '&mdash;'],
];

const categoryColumns = [
  'Category',
  'Trials',
  'Full SSIM &uarr;',
  'BG PSNR &uarr;',
  'Edit SSIM &uarr;',
  'Temp. L1 &darr;',
  'Temp. SSIM &uarr;',
];

const categoryRows = [
  ['Cars', 3, '0.746', '28.84', '0.258', '0.0475', '0.653'],
  ['Cats', 3, '0.605', '25.48', '0.228', '0.0258', '0.850'],
  ['Humans', 1, '0.837', '33.83', '0.417', '0.0153', '0.851'],
];
---

<BaseLayout title="Results">
  <h1>Results</h1>
  <p class="page-intro">
    Quantitative evaluation of AI video inpainting methods on our custom
    real-world dataset, alongside a mask-propagation comparison between SAM2
    and YOLO.
  </p>

  <section class="section">
    <h2 class="section-title">Benchmark Comparison</h2>
    <div class="benchmark-stack">
      <ResultsTable
        label="Table 1."
        caption="Main quantitative comparison across the evaluated methods. PSNR is reported in dB, MAE is reported on the 0–255 intensity scale, and LPIPS is lower better. For CLIP, PSNR values are finite-value means because some samples produced infinite PSNR. The CLIP scores should be read as preservation scores rather than substitution success, because qualitative inspection showed that CLIP often left the original object largely unchanged."
        columns={mainColumns}
        rows={mainRows}
      />
      <ResultsTable
        label="Table 2."
        caption="Category-level Stable Diffusion + SAM2 results. The values show that difficulty varies substantially by object type and scene dynamics."
        columns={categoryColumns}
        rows={categoryRows}
      />
      <Figure
        src={url('/assets/images/plots/back_mae.png')}
        alt="Three grouped bar charts showing background, full-frame, and edit-region MAE for the Diffusion and CLIP methods across the Car, Cat, Human, and Overall categories, on a logarithmic scale with error bars"
        label="Figure 1."
        caption="Category-wise MAE comparison for the matched seven-sequence experiment. Bars report the video-level macro mean and error bars report the sample standard deviation. All MAE values use the 0–255 intensity scale, and lower values are better. The near-zero CLIP errors primarily indicate preservation of the source appearance and should not, by themselves, be interpreted as successful object substitution."
      />
      <Figure
        src={url('/assets/images/plots/time_eff.png')}
        alt="Three bar charts comparing GAN, CLIP, and Stable Diffusion plus SAM2 on reported temporal error, total time per evaluated clip, and effective seconds per frame, all on logarithmic scales"
        label="Figure 2."
        caption="Temporal consistency and computational efficiency across the evaluated methods. The temporal-error values are complementary rather than directly identical: GAN and CLIP use background flow MAE, whereas Stable Diffusion + SAM2 uses frame-to-frame temporal L1. Likewise, GAN and CLIP report evaluation time, while Stable Diffusion + SAM2 reports generation time, so the timing panels indicate computational scale rather than a strictly controlled speed benchmark."
      />
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Mask Quality Metrics</h2>
    <div class="charts-grid">
      <LineChart
        csvUrl={csvUrl}
        xColumn="frame_idx"
        yColumns={['iou']}
        labels={['IoU']}
        title="IoU vs Frame Index"
        yLabel="IoU"
      />
      <LineChart
        csvUrl={csvUrl}
        xColumn="frame_idx"
        yColumns={['dice']}
        labels={['Dice Coefficient']}
        title="Dice Coefficient vs Frame Index"
        yLabel="Dice"
      />
      <LineChart
        csvUrl={csvUrl}
        xColumn="frame_idx"
        yColumns={['ssim']}
        labels={['SSIM']}
        title="SSIM vs Frame Index"
        yLabel="SSIM"
      />
      <LineChart
        csvUrl={csvUrl}
        xColumn="frame_idx"
        yColumns={['area_sam2', 'area_yolo']}
        labels={['SAM2 Mask Area', 'YOLO Mask Area']}
        title="Mask Area Comparison"
        yLabel="Area (pixels)"
      />
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Video Gallery</h2>

    <div class="featured-video card video-card">
      <div class="video-badge">Featured</div>
      <h3>Mask Comparison: YOLO vs SAM2</h3>
      <p class="video-desc">Side-by-side comparison of YOLO and SAM2 mask propagation on the same video clip, highlighting differences in mask quality and temporal stability.</p>
      <video controls preload="metadata">
        <source src={url('/assets/videos/mask_compare_yolo_vs_sam2.mp4')} type="video/mp4" />
      </video>
    </div>

    <div class="video-grid">
      <div class="card video-card">
        <h3>Object Replacement: Cat to Drone</h3>
        <p class="video-desc">Replacing a walking cat with a drone using the full pipeline.</p>
        <video controls preload="metadata">
          <source src={url('/assets/videos/output_replace_cat_to_drone.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="card video-card">
        <h3>Final Result</h3>
        <p class="video-desc">End-to-end pipeline output with motion-aware warping and compositing.</p>
        <video controls preload="metadata">
          <source src={url('/assets/videos/result.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="card video-card">
        <h3>Bear Clip Baseline</h3>
        <p class="video-desc">Baseline clip used for segmentation and inpainting evaluation.</p>
        <video controls preload="metadata">
          <source src={url('/assets/videos/bear_clip_baseline.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="card video-card">
        <h3>Humans Video Preview</h3>
        <p class="video-desc">Non-rigid motion test case with articulated human subjects.</p>
        <video controls preload="metadata">
          <source src={url('/assets/videos/humans_vid3_preview.mp4')} type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Key Findings</h2>
    <div class="grid-2">
      <div class="card stat-card">
        <div class="stat-value">0.91</div>
        <div class="stat-label">Mean IoU</div>
        <p>SAM2 vs YOLO mask overlap across 60 frames</p>
      </div>
      <div class="card stat-card">
        <div class="stat-value">0.95</div>
        <div class="stat-label">Mean Dice</div>
        <p>High mask agreement between methods</p>
      </div>
      <div class="card stat-card">
        <div class="stat-value">0.98</div>
        <div class="stat-label">Mean SSIM</div>
        <p>Near-perfect structural similarity in masked regions</p>
      </div>
      <div class="card stat-card">
        <div class="stat-value">~15K</div>
        <div class="stat-label">Avg Mask Area</div>
        <p>SAM2 produces slightly tighter masks than YOLO</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-intro {
    font-size: 1.1rem;
    color: var(--c-text-muted);
    margin-bottom: var(--space-2xl);
  }
  .benchmark-stack {
    display: grid;
    gap: var(--space-lg);
  }
  .charts-grid {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 1024px) {
    .charts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Featured video — full width */
  .featured-video {
    position: relative;
    margin-bottom: var(--space-lg);
  }
  .video-badge {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    padding: 2px 10px;
    border-radius: var(--radius-sm);
    background: var(--c-primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    z-index: 1;
  }
  .featured-video video {
    width: 100%;
    border-radius: var(--radius-md);
    margin-top: var(--space-sm);
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: #000;
  }

  /* Video grid — 2 columns */
  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }
  @media (min-width: 768px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .video-card {
    display: flex;
    flex-direction: column;
  }
  .video-card video {
    width: 100%;
    border-radius: var(--radius-md);
    margin-top: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: #000;
  }
  .video-card h3 {
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }
  .video-desc {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }
  .stat-card {
    text-align: center;
  }
  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--c-primary);
  }
  .stat-label {
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }
  .stat-card p {
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }
</style>
